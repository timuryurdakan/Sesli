# Supabase (service role used server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis / BullMQ connection (Upstash)
REDIS_URL=

# Max concurrent stem-separation jobs this worker will process at once
MAX_CONCURRENT_JOBS=1

# Path to the SoundTouch `soundstretch` CLI binary (LGPL v2.1 — see
# https://www.surina.net/soundtouch/). Leave unset to fall back to
# `soundstretch` on PATH.
SOUNDSTRETCH_PATH=

# Error tracking (Stage 10 — free Sentry tier). Leave unset to disable.
SENTRY_DSN=
ENVIRONMENT=development
