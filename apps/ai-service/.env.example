# Supabase (service role used server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis / BullMQ connection (Upstash)
REDIS_URL=

# Max concurrent stem-separation jobs this worker will process at once
MAX_CONCURRENT_JOBS=1

# Path to the SoundTouch `soundstretch` CLI binary (LGPL v2.1 — see
# https://www.surina.net/soundtouch/). Leave unset to fall back to
# `soundstretch` on PATH.
SOUNDSTRETCH_PATH=

# Error tracking (Stage 10 — free Sentry tier). Leave unset to disable.
SENTRY_DSN=
ENVIRONMENT=development

# Shared secret required on every request to this service (must match
# apps/api's AI_SERVICE_INTERNAL_KEY exactly). This service holds a
# Supabase service-role key and is not safe to expose without it — requests
# without a matching X-Internal-Service-Key header are rejected (Stage 10
# security audit, Ajan 12 Kritik #1). Generate with: openssl rand -hex 32
AI_SERVICE_INTERNAL_KEY=
