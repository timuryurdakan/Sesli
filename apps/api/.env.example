PORT=3001

# Supabase (service role — server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres connection string (Supabase)
DATABASE_URL=

# Redis / BullMQ connection (Upstash)
REDIS_URL=

# Base URL of the FastAPI AI microservice
AI_SERVICE_URL=http://localhost:8000

# Allowed origin for CORS (the deployed web app URL)
WEB_APP_ORIGIN=http://localhost:3000

# Uploads (Stage 03 — tus resumable upload + FFmpeg normalization)
UPLOAD_MAX_BYTES=524288000
UPLOAD_TMP_DIR=./.tmp/uploads

# Per-user total storage quota in bytes (Stage 08 — Bölüm 9.4 cost control)
MAX_STORAGE_BYTES_PER_USER=2147483648

# Error tracking (Stage 10 — free Sentry tier). Leave unset to disable;
# the SDK no-ops safely without a DSN.
SENTRY_DSN=

# Path to an LGPL-only ffmpeg/ffprobe build (do NOT point this at a GPL/"full"
# build — see Bölüm 9.2). E.g. a BtbN FFmpeg-Builds "*-lgpl*" release binary.
# Leave unset to fall back to `ffmpeg`/`ffprobe` on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
